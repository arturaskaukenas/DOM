{
	"name": "arturaskaukenas/dom",
	"description": "XML/HTML document object model for PHP — build, traverse, transform and stream-parse documents",
	"type": "library",
	"keywords": ["dom", "xml", "html", "document", "parser", "streaming", "serialization", "data-binding"],
	"license": "Apache-2.0",
	"authors": [
		{
			"name": "Artūras Kaukėnas",
			"email": "arturas.kaukenas@outlook.com"
		}
	],
	"require": {
		"php": ">=8.4 <8.6",
		"ext-xml": "*"
	},
	"require-dev": {
		"phpunit/phpunit": "^13.4"
	},
    "suggest": {
		"ext-tidy": "HTML support"
	},
	"autoload": {
		"psr-4": {
			"ArturasKaukenas\\DOM\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"ArturasKaukenas\\tests\\": "tests/"
		}
	},
	"prefer-stable": true,
	"scripts":{
		"test": "phpunit",
		"test_container": "docker compose run --build --rm test",
		"test_container:8.4": "docker compose run --build --rm test-php84",
		"test_container:8.5": "docker compose run --build --rm test-php85",
		"test_container_all": [
			"@test_container:8.4",
			"@test_container:8.5"
		],
		"generate-docs": "docker compose run --build --rm generate-docs"
	}
}
