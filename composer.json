{
	"name": "arturaskaukenas/dom",
	"description": "PHP XML and HTML Parser",
	"version": "1.0.1",
	"type": "library",
	"keywords": ["DOM","XML","HTML", "Object"],
	"license": "Apache-2.0",
	"authors": [
		{
			"name": "Artūras Kaukėnas",
			"email": "arturas.kaukenas@outlook.com"
		}
	],
	"require": {
		"php": ">=8.0",
		"ext-xml": "*"
	},
	"require-dev": {
		"arturaskaukenas/simpletest": "1.0.0",
		"phpunit/phpunit": "^13.4"
	},
    "suggest": {
		"ext-tidy": "HTML support"
	},
	"autoload": {
		"classmap": [
			"src/"
		]
	},
	"autoload-dev": {
		"psr-4": {
			"ArturasKaukenas\\tests\\": "tests/"
		}
	},
	"prefer-stable": true,
	"scripts":{
		"test": "phpunit",
		"test:parity": "phpunit --testsuite parity",
		"test_container": "docker compose run --build --rm test",
		"simple_test": "php simple_tests/all.php",
		"simple_test_container": "docker compose run --build --rm test bash -c \"composer install && composer simple_test\"",
		"generate-docs": "docker compose run --build --rm generate-docs"
	}
}
